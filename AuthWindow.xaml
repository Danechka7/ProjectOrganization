<Window x:Class="ProjectOrganization.AuthWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Авторизация" Height="320" Width="400" WindowStartupLocation="CenterScreen" FontFamily="Times New Roman" FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Вход в систему — Учёт проектных работ" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" Grid.Row="0"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Логин сотрудника:"/>
            <TextBox Name="TxtLogin" Height="30" VerticalContentAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <TextBlock Text="Пароль:"/>
            <PasswordBox Name="TxtPassword" Height="30" VerticalContentAlignment="Center"/>
        </StackPanel>
        <Button Content="Войти" Grid.Row="3" Height="40" Width="120" HorizontalAlignment="Center" Click="BtnLogin_Click"/>
    </Grid>
</Window>