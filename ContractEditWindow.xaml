<Window x:Class="ProjectOrganization.ContractEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Договор" Height="480" Width="450" WindowStartupLocation="CenterScreen" FontFamily="Times New Roman" FontSize="14" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>  
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TxtTitle" Text="Договор" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15" Grid.Row="0" HorizontalAlignment="Center"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Номер договора *"/>
            <TextBox Name="TxtNumber" Height="25" IsReadOnly="True" Background="#F0F0F0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Сумма *"/>
            <TextBox Name="TxtAmount" Height="25" PreviewTextInput="OnlyNumbers_PreviewTextInput"/>
        </StackPanel>
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock Text="Организация *"/>
                <ComboBox Name="CmbOrganization" Height="25" DisplayMemberPath="OrgName" SelectedValuePath="OrganizationID"/>
            </StackPanel>
            <Button Grid.Column="1" Content="+" Width="30" Height="25" VerticalAlignment="Bottom" Background="#3498DB" Foreground="White" FontWeight="Bold" Click="BtnAddNewOrg_Click"/>
        </Grid>
        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="Ответственный сотрудник *"/>
            <ComboBox Name="CmbEmployee" Height="25" DisplayMemberPath="LastName" SelectedValuePath="EmployeeID"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Margin="0,0,0,10">
                <TextBlock Text="Дата договора"/>
                <DatePicker Name="DpContractDate" Height="25" IsEnabled="False" Background="#F0F0F0"/>
        </StackPanel>
            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Сохранить" Width="120" Height="35" Margin="0,0,15,0" Background="#2ECC71" Foreground="White" FontWeight="Bold" Click="BtnSave_Click"/>
            <Button Content="Отмена" Width="120" Height="35" Background="#E74C3C" Foreground="White" FontWeight="Bold" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>