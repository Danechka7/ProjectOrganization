<Window x:Class="ProjectOrganization.DepartmentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отдел" Height="380" Width="400" 
        WindowStartupLocation="CenterScreen"
        FontFamily="Times New Roman" FontSize="14" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitle" Text="Отдел" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20" HorizontalAlignment="Center" Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Text="Название *"/>
            <TextBox Name="TxtName" Height="30"/>
        </StackPanel>

        <!-- ЭТАЖ: 0-10, макс 2 цифры -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Этаж (0-10)"/>
            <TextBox Name="TxtFloor" Height="30" MaxLength="2" PreviewTextInput="TxtFloor_PreviewTextInput"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="Телефон * (формат: 12-34)"/>
            <TextBox Name="TxtPhone" Height="30" MaxLength="5" PreviewTextInput="TxtPhone_PreviewTextInput" TextChanged="TxtPhone_TextChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,20">
            <TextBlock Text="Начальник отдела *"/>
            <ComboBox Name="CmbHead" Height="30" DisplayMemberPath="LastName" SelectedValuePath="EmployeeID"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Сохранить" Width="120" Height="35" Margin="0,0,15,0" Background="#2ECC71" Foreground="White" FontWeight="Bold" Click="BtnSave_Click"/>
            <Button Content="Отмена" Width="120" Height="35" Background="#E74C3C" Foreground="White" FontWeight="Bold" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>