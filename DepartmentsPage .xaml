<Page x:Class="ProjectOrganization.DepartmentsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Отделы" FontFamily="Times New Roman" FontSize="14" Background="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F6F9" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
            <TextBlock Text="Подразделения и отделы организации" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Name="TBoxSearch" Width="150" TextChanged="TBoxSearch_TextChanged"/>
                <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <ComboBox Name="CmbSort" Width="150" SelectionChanged="CmbSort_SelectionChanged">
                    <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                    <ComboBoxItem Content="По названию (А-Я)"/>
                    <ComboBoxItem Content="По этажу (возр.)"/>
                </ComboBox>
            </WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Name="BtnAdd" Content="+ Добавить" Width="120" Height="30" Margin="0,0,10,0" Click="BtnAdd_Click" Background="#2ECC71" Foreground="White" FontWeight="Bold"/>
                <Button Name="BtnDelete" Content="Удалить" Width="100" Height="30" Click="BtnDelete_Click" Background="#E74C3C" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#E9ECEF" BorderBrush="#CED4DA" BorderThickness="1" Padding="6,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="135"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ID" FontWeight="Bold" Margin="3,0"/>
                <TextBlock Grid.Column="1" Text="Название отдела" FontWeight="Bold" Margin="3,0"/>
                <TextBlock Grid.Column="2" Text="Этаж" FontWeight="Bold" Margin="3,0"/>
                <TextBlock Grid.Column="3" Text="Телефон" FontWeight="Bold" Margin="3,0"/>
                <TextBlock Grid.Column="4" Text="Руководитель" FontWeight="Bold" Margin="3,0"/>
            </Grid>
        </Border>

        <ListView Name="DepartmentListView" Grid.Row="3" MouseDoubleClick="DepartmentListView_MouseDoubleClick" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="2"/>
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#F9F9F9"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="4,5" BorderBrush="#EFEFEF" BorderThickness="0,0,0,1">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="135"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding DepartmentID}" FontWeight="Bold" Margin="3,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding DepartmentName}" Margin="3,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="2" Text="{Binding Floor}" Margin="3,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="{Binding Phone}" Margin="3,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="{Binding HeadNameDisplay}" Margin="3,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>