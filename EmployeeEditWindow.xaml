<Window x:Class="ProjectOrganization.EmployeeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сотрудник" Height="560" Width="420" 
        WindowStartupLocation="CenterScreen"
        FontFamily="Times New Roman" FontSize="14"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Фамилия -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Имя -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Отчество -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Пол (НОВОЕ) -->
            <RowDefinition Height="Auto"/>
            <!-- 5: Должность -->
            <RowDefinition Height="Auto"/>
            <!-- 6: Отдел -->
            <RowDefinition Height="Auto"/>
            <!-- 7: Адрес -->
            <RowDefinition Height="Auto"/>
            <!-- 8: Дата рождения -->
            <RowDefinition Height="*"/>
            <!-- 9: Пустое место -->
            <RowDefinition Height="Auto"/>
            <!-- 10: Кнопки -->
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitle" Text="Сотрудник" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15" Grid.Row="0" HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Фамилия *"/>
            <TextBox Name="TxtLastName" Height="30"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Имя *"/>
            <TextBox Name="TxtFirstName" Height="30"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="Отчество"/>
            <TextBox Name="TxtPatronymic" Height="30"/>
        </StackPanel>

        <!-- ПОЛ -->
        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="Пол *"/>
            <ComboBox Name="CmbGender" Height="30">
                <ComboBoxItem Content="М"/>
                <ComboBoxItem Content="Ж"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,8">
            <TextBlock Text="Должность *"/>
            <ComboBox Name="CmbPosition" Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Margin="0,0,0,8">
            <TextBlock Text="Отдел"/>
            <ComboBox Name="CmbDepartment" Height="30" DisplayMemberPath="DepartmentName" SelectedValuePath="DepartmentID"/>
        </StackPanel>

        <!-- АДРЕС (две колонки) -->
        <Grid Grid.Row="7" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock Text="Улица"/>
                <TextBox Name="TxtStreet" Height="30"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                <TextBlock Text="Дом"/>
                <TextBox Name="TxtHouse" Height="30" PreviewTextInput="OnlyNumbers_PreviewTextInput"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="8" Margin="0,0,0,10">
            <TextBlock Text="Дата рождения * (не моложе 18 лет)"/>
            <DatePicker Name="DpBirthDate" Height="30" SelectedDateChanged="DpBirthDate_SelectedDateChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Сохранить" Width="120" Height="35" Margin="0,0,15,0" Background="#2ECC71" Foreground="White" FontWeight="Bold" Click="BtnSave_Click"/>
            <Button Content="Отмена" Width="120" Height="35" Background="#E74C3C" Foreground="White" FontWeight="Bold" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>