<Window x:Class="ProjectOrganization.EmployeeEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Сотрудник" Height="680" Width="440" WindowStartupLocation="CenterScreen" FontFamily="Times New Roman" FontSize="14" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TxtTitle" Text="Сотрудник" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,12" Grid.Row="0" HorizontalAlignment="Center"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,6">
            <TextBlock Text="Фамилия *"/>
            <TextBox Name="TxtLastName" Height="25"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,6">
            <TextBlock Text="Имя *"/>
            <TextBox Name="TxtFirstName" Height="25"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,6">
            <TextBlock Text="Отчество"/>
            <TextBox Name="TxtPatronymic" Height="25"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,0,0,6">
            <TextBlock Text="Пол *"/>
            <ComboBox Name="CmbGender" Height="25">
                <ComboBoxItem Content="М"/>
                <ComboBoxItem Content="Ж"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Grid.Row="5" Margin="0,0,0,6">
            <TextBlock Text="Должность *"/>
            <ComboBox Name="CmbPosition" Height="25"/>
        </StackPanel>
        <StackPanel Grid.Row="6" Margin="0,0,0,6">
            <TextBlock Text="Отдел"/>
            <ComboBox Name="CmbDepartment" Height="25" DisplayMemberPath="DepartmentName" SelectedValuePath="DepartmentID"/>
        </StackPanel>
        <Grid Grid.Row="7" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock Text="Улица"/>
                <TextBox Name="TxtStreet" Height="25"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                <TextBlock Text="Дом"/>
                <TextBox Name="TxtHouse" Height="25" PreviewTextInput="OnlyNumbers_PreviewTextInput"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="8" Margin="0,0,0,6">
            <TextBlock Text="Дата рождения * (от 18 лет)"/>
            <DatePicker Name="DpBirthDate" Height="25" SelectedDateChanged="DpBirthDate_SelectedDateChanged"/>
        </StackPanel>
        <StackPanel Grid.Row="9" Margin="0,0,0,6">
            <TextBlock Text="Логин (уникальный) *"/>
            <TextBox Name="TxtLogin" Height="25"/>
        </StackPanel>
        <StackPanel Grid.Row="10" Margin="0,0,0,10">
            <TextBlock Text="Пароль *"/>
            <TextBox Name="TxtPassword" Height="25"/>
        </StackPanel>
        <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button Content="Сохранить" Width="120" Height="35" Margin="0,0,15,0" Background="#2ECC71" Foreground="White" FontWeight="Bold" Click="BtnSave_Click"/>
            <Button Content="Отмена" Width="120" Height="35" Background="#E74C3C" Foreground="White" FontWeight="Bold" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>