<Page x:Class="ProjectOrganization.EmployeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Сотрудники" FontFamily="Times New Roman" FontSize="14" Background="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4F6F9" BorderBrush="#D0D7DE" BorderThickness="1"
                CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
            <TextBlock Text="Сотрудники организации" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Name="TBoxSearch" Width="120" TextChanged="TBoxSearch_TextChanged"/>
                <TextBlock Text="Отдел:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <ComboBox Name="CmbFilterDept" Width="140" DisplayMemberPath="DepartmentName"
                          SelectedValuePath="DepartmentID" SelectionChanged="CmbFilterDept_SelectionChanged"/>
                <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                <ComboBox Name="CmbSort" Width="150" SelectionChanged="CmbSort_SelectionChanged">
                    <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                    <ComboBoxItem Content="По фамилии (А-Я)"/>
                    <ComboBoxItem Content="По фамилии (Я-А)"/>
                    <ComboBoxItem Content="По возрасту (убыв.)"/>
                </ComboBox>
            </WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Name="BtnAdd" Content="+ Добавить" Width="120" Height="30" Margin="0,0,10,0"
                        Click="BtnAdd_Click" Background="#2ECC71" Foreground="White" FontWeight="Bold"/>
                <Button Name="BtnDelete" Content="Удалить" Width="100" Height="30"
                        Click="BtnDelete_Click" Background="#E74C3C" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#E9ECEF" BorderBrush="#CED4DA" BorderThickness="1" Padding="6,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="95"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition x:Name="LoginHeaderCol" Width="95"/>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ID" FontWeight="Bold" Margin="3,0"/>
                <TextBlock Grid.Column="1" Text="Фамилия" FontWeight="Bold" Margin="3,0"/>
                <TextBlock Grid.Column="2" Text="Имя" FontWeight="Bold" Margin="3,0"/>
                <TextBlock Grid.Column="3" Text="Отчество" FontWeight="Bold" Margin="3,0"/>
                <TextBlock Grid.Column="4" Text="Должность" FontWeight="Bold" Margin="3,0"/>
                <TextBlock Grid.Column="5" Text="Отдел" FontWeight="Bold" Margin="3,0"/>
                <TextBlock x:Name="TxtLoginHeader" Grid.Column="6" Text="Логин" FontWeight="Bold" Margin="3,0"/>
                <TextBlock Grid.Column="7" Text="Пол" FontWeight="Bold" Margin="3,0"/>
                <TextBlock Grid.Column="8" Text="Возраст" FontWeight="Bold" Margin="3,0"/>
                <TextBlock Grid.Column="9" Text="Адрес" FontWeight="Bold" Margin="3,0"/>
            </Grid>
        </Border>

        <!-- >>> ИЗМЕНЕНИЕ: SelectionMode="Single" + подсветка выбранной строки <<< -->
        <ListView Name="EmployeeListView" Grid.Row="3"
                  SelectionMode="Single"
                  MouseDoubleClick="EmployeeListView_MouseDoubleClick"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="2"/>
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#F9F9F9"/>
                        </Trigger>
                        <!-- >>> ИЗМЕНЕНИЕ: видимая подсветка выбранной строки <<< -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#BBDEFB"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#E3F2FD"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="RowBorder" Padding="4,5" CornerRadius="3"
                            BorderBrush="#EFEFEF" BorderThickness="0,0,0,1">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="125"/>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="{Binding ElementName=LoginHeaderCol, Path=Width}"/>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding EmployeeID}" FontWeight="Bold" Margin="3,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding LastName}" Margin="3,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding FirstName}" Margin="3,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="3" Text="{Binding Patronymic}" Margin="3,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="4" Text="{Binding Position}" Margin="3,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="5" Text="{Binding DepartmentNameDisplay}" Margin="3,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="6" Text="{Binding Login}" Margin="3,0" VerticalAlignment="Center"
                                       Visibility="{Binding DataContext.IsLoginVisible,
                                                    RelativeSource={RelativeSource AncestorType=Page},
                                                    Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock Grid.Column="7" Text="{Binding Gender}" Margin="3,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="8" Text="{Binding Age}" Margin="3,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="9" Text="{Binding Address}" Margin="3,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Position}" Value="Начальник отдела">
                            <Setter TargetName="RowBorder" Property="Background" Value="#FFF9C4"/>
                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="#F1C40F"/>
                            <Setter TargetName="RowBorder" Property="BorderThickness" Value="1"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>