<Page x:Class="ProjectOrganization.EmployeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Сотрудники" FontFamily="Times New Roman" FontSize="14"
      Background="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Name="TBoxSearch" Width="120" TextChanged="TBoxSearch_TextChanged"/>
                <TextBlock Text="Отдел:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <ComboBox Name="CmbFilterDept" Width="150" DisplayMemberPath="DepartmentName" SelectedValuePath="DepartmentID" SelectionChanged="CmbFilterDept_SelectionChanged"/>
                <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <ComboBox Name="CmbSort" Width="150" SelectionChanged="CmbSort_SelectionChanged">
                    <ComboBoxItem Content="Без сортировки" IsSelected="True"/>
                    <ComboBoxItem Content="По фамилии (А-Я)"/>
                    <ComboBoxItem Content="По фамилии (Я-А)"/>
                    <ComboBoxItem Content="По возрасту (убыв.)"/>
                </ComboBox>
            </WrapPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Name="BtnAdd" Content="+ Добавить" Width="120" Height="30" Margin="0,0,10,0" Click="BtnAdd_Click" Background="#2ECC71" Foreground="White" FontWeight="Bold"/>
                <!-- КНОПКА УДАЛЕНИЯ -->
                <Button Name="BtnDelete" Content="Удалить" Width="100" Height="30" Click="BtnDelete_Click" Background="#E74C3C" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <ListView Name="EmployeeListView" Grid.Row="1" MouseDoubleClick="EmployeeListView_MouseDoubleClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#F9F9F9"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="RowBorder" Padding="5" CornerRadius="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding EmployeeID}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding LastName}"/>
                            <TextBlock Grid.Column="2" Text="{Binding FirstName}"/>
                            <TextBlock Grid.Column="3" Text="{Binding Patronymic}"/>
                            <TextBlock Grid.Column="4" Text="{Binding Position}"/>
                            <TextBlock Grid.Column="5" Text="{Binding Departments.DepartmentName}"/>
                            <TextBlock Grid.Column="6" Text="{Binding Gender}"/>
                            <TextBlock Grid.Column="7" Text="{Binding Age}"/>
                            <TextBlock Grid.Column="8" Text="{Binding Address}"/>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <!-- Подсветка золотым для начальников -->
                        <DataTrigger Binding="{Binding Position}" Value="Начальник отдела">
                            <Setter TargetName="RowBorder" Property="Background" Value="#FFF9C4"/>
                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="#F1C40F"/>
                            <Setter TargetName="RowBorder" Property="BorderThickness" Value="1"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>