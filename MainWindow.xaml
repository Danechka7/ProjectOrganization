<Window x:Class="ProjectOrganization.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Проектная организация" Height="700" Width="1100" WindowStartupLocation="CenterScreen" FontFamily="Times New Roman" FontSize="14">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Background="#2C3E50">
            <TextBlock Text="ПРОЕКТНАЯ ОРГАНИЗАЦИЯ" Foreground="White" FontSize="16" FontWeight="Bold" TextAlignment="Center" Margin="10,20,10,30" TextWrapping="Wrap"/>
            <Button Content="Сотрудники" Height="40" Margin="10,5" Click="BtnEmployees_Click"/>
            <Button Content="Отделы" Height="40" Margin="10,5" Click="BtnDepartments_Click"/>
            <Button Content="Организации" Height="40" Margin="10,5" Click="BtnOrganizations_Click"/>
            <Button Content="Договора" Height="40" Margin="10,5" Click="BtnContracts_Click"/>
            <Button Content="Работы" Height="40" Margin="10,5" Click="BtnWorks_Click"/>
            <Border Name="UserInfoBorder" CornerRadius="4" Padding="6,4" Margin="10,30,10,5" Background="Transparent">
                <TextBlock Name="TxtUserInfo" Foreground="White" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
            </Border>
            <Button Content="Выход" Height="40" Margin="10,5,10,20" Background="#E74C3C" Click="BtnExit_Click"/>
        </StackPanel>
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#EBF1F6" BorderBrush="#C8D3DC" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                <TextBlock Text="Система управления проектной организацией" FontSize="18" FontWeight="Bold" Foreground="#1F2D3D"/>
            </Border>
            <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Background="White" BorderBrush="#DDD" BorderThickness="1"/>
        </Grid>
    </Grid>
</Window>