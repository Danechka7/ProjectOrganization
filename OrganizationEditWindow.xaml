<Window x:Class="ProjectOrganization.OrganizationEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Организация" Height="520" Width="450" 
        WindowStartupLocation="CenterScreen"
        FontFamily="Times New Roman" FontSize="14"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Название -->
            <RowDefinition Height="Auto"/>
            <!-- Деятельность -->
            <RowDefinition Height="Auto"/>
            <!-- Страна -->
            <RowDefinition Height="Auto"/>
            <!-- Город -->
            <RowDefinition Height="Auto"/>
            <!-- Адрес -->
            <RowDefinition Height="Auto"/>
            <!-- Директор -->
            <RowDefinition Height="*"/>
            <!-- Пустое место -->
            <RowDefinition Height="Auto"/>
            <!-- Кнопки -->
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitle" Text="Организация" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15" Grid.Row="0" HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Название *"/>
            <TextBox Name="TxtOrgName" Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Тип деятельности"/>
            <TextBox Name="TxtActivityType" Height="30"/>
        </StackPanel>

        <!-- СТРАНА И ГОРОД В ОДНОЙ СТРОКЕ -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock Text="Страна"/>
                <TextBox Name="TxtCountry" Height="30"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                <TextBlock Text="Город"/>
                <TextBox Name="TxtCity" Height="30"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="Адрес"/>
            <TextBox Name="TxtAddress" Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,0,0,20">
            <TextBlock Text="ФИО Директора"/>
            <TextBox Name="TxtDirectorName" Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Сохранить" Width="120" Height="35" Margin="0,0,15,0" Background="#2ECC71" Foreground="White" FontWeight="Bold" Click="BtnSave_Click"/>
            <Button Content="Отмена" Width="120" Height="35" Background="#E74C3C" Foreground="White" FontWeight="Bold" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>