<Window x:Class="ProjectOrganization.OrganizationEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Организация" Height="480" Width="400" WindowStartupLocation="CenterScreen" FontFamily="Times New Roman" FontSize="14" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TxtTitle" Text="Организация" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15" Grid.Row="0" HorizontalAlignment="Center"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Название *"/>
            <TextBox Name="TxtOrgName" Height="25"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Тип деятельности *"/>
            <TextBox Name="TxtActivityType" Height="25"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="Страна *"/>
            <TextBox Name="TxtCountry" Height="25"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="Город *"/>
            <TextBox Name="TxtCity" Height="25"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Margin="0,0,0,8">
            <TextBlock Text="Адрес *"/>
            <TextBox Name="TxtAddress" Height="25"/>
        </StackPanel>
        <StackPanel Grid.Row="6" Margin="0,0,0,20">
            <TextBlock Text="ФИО Директора *"/>
            <TextBox Name="TxtDirectorName" Height="25"/>
        </StackPanel>
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <Button Content="Сохранить" Width="120" Height="35" Margin="0,0,15,0" Background="#2ECC71" Foreground="White" FontWeight="Bold" Click="BtnSave_Click"/>
            <Button Content="Отмена" Width="120" Height="35" Background="#E74C3C" Foreground="White" FontWeight="Bold" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>