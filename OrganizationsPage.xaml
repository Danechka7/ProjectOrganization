<Page x:Class="ProjectOrganization.OrganizationsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Организации" FontFamily="Times New Roman" FontSize="14"
      Background="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Name="TBoxSearch" Width="150" TextChanged="TBoxSearch_TextChanged"/>

                <TextBlock Text="Город:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <ComboBox Name="CmbFilterCity" Width="150" SelectionChanged="CmbFilterCity_SelectionChanged"/>
            </WrapPanel>

            <Button Name="BtnAdd" Grid.Column="1" Content="+ Добавить организацию" Width="180" Height="30" 
                    Click="BtnAdd_Click" Background="#2ECC71" Foreground="White" FontWeight="Bold"/>
        </Grid>

        <ListView Name="OrganizationListView" Grid.Row="1" MouseDoubleClick="OrganizationListView_MouseDoubleClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#F9F9F9"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding OrganizationID}" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="{Binding OrgName}"/>
                            <TextBlock Grid.Column="2" Text="{Binding ActivityType}"/>
                            <TextBlock Grid.Column="3" Text="{Binding City}"/>
                            <TextBlock Grid.Column="4" Text="{Binding DirectorName}"/>
                            <TextBlock Grid.Column="5" Text="{Binding Address}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>