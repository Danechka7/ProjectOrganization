<Page x:Class="ProjectOrganization.OrganizationsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Организации" FontFamily="Times New Roman" FontSize="14" Background="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка страницы -->
        <Border Grid.Row="0" Background="#F4F6F9" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
            <TextBlock Text="Организации-заказчики" FontSize="18" FontWeight="Bold" Foreground="#2C3E50"/>
        </Border>

        <!-- Панель поиска, фильтра и кнопок -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox Name="TBoxSearch" Width="150" TextChanged="TBoxSearch_TextChanged"/>
                <TextBlock Text="Город:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                <ComboBox Name="CmbFilterCity" Width="150" SelectionChanged="CmbFilterCity_SelectionChanged"/>
            </WrapPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Name="BtnAdd" Content="+ Добавить" Width="150" Height="30" Margin="0,0,10,0" Click="BtnAdd_Click" Background="#2ECC71" Foreground="White" FontWeight="Bold"/>
                <Button Name="BtnDelete" Content="Удалить" Width="100" Height="30" Click="BtnDelete_Click" Background="#E74C3C" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <!-- Шапка таблицы -->
        <Border Grid.Row="2" Background="#E9ECEF" BorderBrush="#CED4DA" BorderThickness="1" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ID" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="Название организации" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="Вид деятельности" FontWeight="Bold"/>
                <TextBlock Grid.Column="3" Text="Город" FontWeight="Bold"/>
                <TextBlock Grid.Column="4" Text="Руководитель" FontWeight="Bold"/>
                <TextBlock Grid.Column="5" Text="Адрес" FontWeight="Bold"/>
            </Grid>
        </Border>

        <ListView Name="OrganizationListView" Grid.Row="3" MouseDoubleClick="OrganizationListView_MouseDoubleClick" HorizontalContentAlignment="Stretch">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#F9F9F9"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="5" BorderBrush="#EFEFEF" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding OrganizationID}" FontWeight="Bold" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" Text="{Binding OrgName}" TextWrapping="Wrap" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="2" Text="{Binding ActivityType}" TextWrapping="Wrap" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="3" Text="{Binding City}" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="4" Text="{Binding DirectorName}" TextWrapping="Wrap" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="5" Text="{Binding Address}" TextWrapping="Wrap" VerticalAlignment="Top"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>