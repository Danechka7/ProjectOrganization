<Window x:Class="ProjectOrganization.WorkEditWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Работа" Height="470" Width="440" WindowStartupLocation="CenterScreen" FontFamily="Times New Roman" FontSize="14" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TxtTitle" Text="Работа" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15" Grid.Row="0" HorizontalAlignment="Center"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Договор *"/>
            <ComboBox Name="CmbContract" Height="25" DisplayMemberPath="ContractNumber" SelectedValuePath="ContractID"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <TextBlock Text="Отдел *"/>
            <ComboBox Name="CmbDepartment" Height="25" DisplayMemberPath="DepartmentName" SelectedValuePath="DepartmentID"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="Ответственный сотрудник *"/>
            <ComboBox Name="CmbEmployee" Height="25" DisplayMemberPath="LastName" SelectedValuePath="EmployeeID"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock Text="Описание того, что нужно сделать *"/>
            <TextBox Name="TxtDescription" Height="110" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
            <Button Content="Сохранить" Width="120" Height="35" Margin="0,0,15,0" Background="#2ECC71" Foreground="White" FontWeight="Bold" Click="BtnSave_Click"/>
            <Button Content="Отмена" Width="120" Height="35" Background="#E74C3C" Foreground="White" FontWeight="Bold" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>